{
  "upstream": "JeffSteinbok/obsidian-onedrive",
  "tagFormat": "{version}",
  "versionFields": [
    { "path": "manifest.json", "field": "version" },
    { "path": "package.json", "field": "version" },
    { "path": "versions.json", "addEntry": true }
  ],
  "lockfile": "package-lock.json",
  "install": "npm ci",
  "test": "npx vitest run",
  "build": "npm run build",
  "pack": "",
  "assets": ["main.js", "manifest.json", "styles.css"],
  "nodeVersion": "24"
}
